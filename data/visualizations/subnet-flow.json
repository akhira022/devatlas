      "position": {
        "x": 660,
        "y": 120
      }
    },
    {
      "id": "hosts",
      "label": "Host Range",
      "description": ".65 – .126 (62 usable hosts)",
      "type": "device",
      "position": {
        "x": 880,
        "y": 120
      }
    }
  ],
  "steps": [
    {
      "id": "sub-1",
      "from": "input",
      "to": "mask",
      "label": "Prefix → Mask",
      "packet": "/26 = 255.255.255.192",
      "description": "แปลง CIDR prefix เป็น subnet mask — /26 หมายถึง 26 bit เป็น 1",
      "duration": 1200
    },
    {
      "id": "sub-2",
      "from": "mask",
      "to": "network",
      "label": "AND",
      "packet": "100 AND 192 = 64",
      "description": "คำนวณ network address ด้วย IP AND Mask — block size = 256 - 192 = 64",
      "duration": 1400
    },
    {
      "id": "sub-3",
      "from": "network",
      "to": "broadcast",
      "label": "Broadcast",
      "packet": "64 + 64 - 1 = 127",
      "description": "Broadcast = network + block size - 1 → 192.168.1.127",
      "duration": 1200
    },
    {
      "id": "sub-4",
      "from": "broadcast",
      "to": "hosts",
      "label": "Host Range",
      "packet": ".65 – .126 (62 hosts)",
      "description": "Usable hosts = network+1 ถึง broadcast-1 — สูตร 2^(32-prefix) - 2 = 62",
      "duration": 1400
    }
  ]
